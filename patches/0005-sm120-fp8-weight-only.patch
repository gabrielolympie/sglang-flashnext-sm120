index 57ced60..1295a12 100644
--- a/python/sglang/srt/layers/quantization/unquant.py
+++ b/python/sglang/srt/layers/quantization/unquant.py
@@ -207,6 +207,7 @@ def initialize_bf16_gemm_config(server_args: ServerArgs) -> None:
         and torch.cuda.get_device_capability() == (12, 0)
         and not server_args.enable_deterministic_inference
     ):
+        import sglang.kernels.ops.gemm.sm120_lowm_bf16_gemm as _sm120_mod
         from sglang.kernels.ops.gemm.sm120_lowm_bf16_gemm import (
             sm120_lowm_bf16_gemm,
             use_sm120_lowm_bf16_gemm,
@@ -215,7 +216,11 @@ def initialize_bf16_gemm_config(server_args: ServerArgs) -> None:
         _sm120_lowm_bf16_gemm = sm120_lowm_bf16_gemm
         _use_sm120_lowm_bf16_gemm = use_sm120_lowm_bf16_gemm
         _enable_sm120_lowm_bf16_gemm = True
-        logger.info("SM120 low-M BF16 GEMM path enabled")
+        _sm120_mod.fp8_weight_enabled = envs.SGLANG_SM120_LOWM_FP8_WEIGHT.get()
+        logger.info(
+            "SM120 low-M BF16 GEMM path enabled (fp8 weight-only: %s)",
+            _sm120_mod.fp8_weight_enabled,
+        )
 
     _BF16_GEMM_BACKEND = backend
 
