 python/sglang/srt/environ.py                  |  4 ++
 python/sglang/srt/layers/hc_mix_triton.py     | 42 ++++++++++++++-
 python/sglang/srt/layers/logits_processor.py  | 16 ++++--
 .../sglang/srt/layers/quantization/unquant.py |  4 +-
 5 files changed, 107 insertions(+), 10 deletions(-)

diff --git a/python/sglang/kernels/ops/gemm/sm120_lowm_bf16_gemm.py b/python/sglang/kernels/ops/gemm/sm120_lowm_bf16_gemm.py
index c27cda2..471d57b 100644
--- a/python/sglang/kernels/ops/gemm/sm120_lowm_bf16_gemm.py
+++ b/python/sglang/kernels/ops/gemm/sm120_lowm_bf16_gemm.py
@@ -173,10 +173,19 @@ _FP8W_CACHE_MAX_BYTES = 6 * 1024**3
 
 
 def _quantize_rowwise_fp8(w: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
-    amax = w.abs().amax(dim=1, keepdim=True).float().clamp_min(1e-8)
-    scale = amax / 448.0
-    w_q = (w.float() / scale).clamp(-448.0, 448.0).to(torch.float8_e4m3fn)
-    return w_q.contiguous(), scale.squeeze(1).contiguous()
+    n = w.shape[0]
+    w_q = torch.empty_like(w, dtype=torch.float8_e4m3fn)
+    scale = torch.empty(n, dtype=torch.float32, device=w.device)
+    # Chunk rows: a full-tensor fp32 temp of the 1.27 GB lm_head would need
+    # ~5 GB that a 0.96-mem-fraction server does not have.
+    step = max(1, (64 * 1024 * 1024) // max(1, w.shape[1] * 4))
+    for i in range(0, n, step):
+        blk = w[i : i + step].float()
+        amax = blk.abs().amax(dim=1, keepdim=True).clamp_min(1e-8)
+        s = amax / 448.0
+        w_q[i : i + step] = (blk / s).clamp(-448.0, 448.0).to(torch.float8_e4m3fn)
+        scale[i : i + step] = s.squeeze(1)
+    return w_q, scale
 
 
 def _get_fp8_weight(weight: torch.Tensor):
@@ -278,6 +287,40 @@ def sm120_lowm_bf16_gemm(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
     return out.view(*x.shape[:-1], n)
 
 
+# Set by initialize_bf16_gemm_config from SGLANG_SM120_LM_HEAD_FP8.
+lm_head_fp8_enabled = False
+
+
+def maybe_sm120_fp8_lm_head(
+    hidden_states: torch.Tensor, weight: torch.Tensor
+) -> Optional[torch.Tensor]:
+    """FP8 weight-only lm_head GEMV for decode-size row counts, or None to
+    let the caller keep the cuBLAS bf16 path (which runs at ~94% of DRAM
+    bandwidth but reads 2x the bytes)."""
+    if not (lm_head_fp8_enabled and fp8_weight_enabled):
+        return None
+    if hidden_states.dim() != 2 or hidden_states.shape[0] > _MAX_M:
+        return None
+    if hidden_states.dtype != torch.bfloat16 or weight.dtype != torch.bfloat16:
+        return None
+    entry = _get_fp8_weight(weight)
+    if entry is None:
+        return None
+    w_q, scale = entry
+    m, k = hidden_states.shape
+    n = w_q.shape[0]
+    out = torch.empty((m, n), dtype=torch.bfloat16, device=hidden_states.device)
+    _sm120_lowm_gemm_fp8w_kernel[(triton.cdiv(n, 32), 1)](
+        hidden_states, w_q, scale, out, m, n, k,
+        hidden_states.stride(0), hidden_states.stride(1),
+        w_q.stride(0), w_q.stride(1),
+        out.stride(0), out.stride(1),
+        BLOCK_N=32, BLOCK_K=128, BLOCK_M=max(16, triton.next_power_of_2(m)),
+        SPLIT_K=1, NUM_STAGES=4, OUT_BF16=True, num_warps=4,
+    )
+    return out
+
+
 def precompile_sm120_lowm_tactics(device: Optional[torch.device] = None) -> None:
     """JIT-compile the tuned specializations before CUDA graph capture."""
     for m, n, k in _SM120_TUNED_TACTICS:
